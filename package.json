{
	"name": "redivis",
	"version": "0.4.1",
	"description": "Redivis client library for javascript",
	"author": "Redivis Inc.",
	"license": "MIT",
	"homepage": "https://github.com/redivis/redivis-js",
	"bugs": {
		"url": "https://github.com/redivis/redivis-js/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/redivis/redivis-js.git"
	},
	"scripts": {
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "cd test/unit && node --test",
		"test:integration": "cd test/integration && node --use-system-ca --test --test-global-setup=setup.js --test-timeout=900000",
		"test:coverage": "cd test/unit && node --test --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/node_modules/**'",
		"test:browser": "(sleep 1 && open http://127.0.0.1:9000/test/browser) & python3 -m http.server 9000",
		"build:types": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run test:unit && npm run build:types"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./index.js"
		}
	},
	"types": "./types/index.d.ts",
	"files": [
		"index.js",
		"src",
		"types"
	],
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"redivis"
	],
	"dependencies": {
		"apache-arrow": "^21.0.0",
		"temporal-polyfill": "^1.0.5"
	},
	"devDependencies": {
		"prettier": "3.9.10",
		"typescript": "^6.0.3"
	},
	"prettier": {
		"printWidth": 120,
		"useTabs": true,
		"tabWidth": 4,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "all",
		"bracketSpacing": true,
		"jsxBracketSameLine": false,
		"arrowParens": "always"
	}
}
